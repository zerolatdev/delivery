{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2023",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "strictPropertyInitialization": false,
    "outDir": "./dist",
    "sourceMap": true,
    "incremental": true,
    "types": ["node"]
  },
  "include": ["src", "test", "*.config.ts"]
}
