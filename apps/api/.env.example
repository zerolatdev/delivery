# Copiar a apps/api/.env y completar. Nunca subir .env a git.

# Supabase → botón "Connect" → cadena del "Session pooler" (puerto 5432).
# Reemplazar [YOUR-PASSWORD] por la contraseña de la base de datos.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API → Project URL.
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → secret key (sb_secret_…).
# Solo para el servidor: nunca va en la app móvil ni en git.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Puerto HTTP del servidor.
PORT=3000
